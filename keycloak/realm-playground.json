{
  "realm": "playground",
  "enabled": true,
  "sslRequired": "none",
  "groups": [
    { "name": "llm-users", "path": "/llm-users" },
    { "name": "foobar", "path": "/foobar" }
  ],
  "clients": [
    {
      "clientId": "key-broker",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "secret": "${KEY_BROKER_CLIENT_SECRET}",
      "redirectUris": ["http://localhost:4000/broker/callback"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "false",
            "claim.name": "groups"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "groups": ["/llm-users", "/foobar"],
      "credentials": [
        { "type": "password", "value": "${ALICE_PASSWORD}", "temporary": false }
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.com",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Example",
      "groups": ["/llm-users", "/foobar"],
      "credentials": [
        { "type": "password", "value": "${BOB_PASSWORD}", "temporary": false }
      ]
    },
    {
      "username": "eve",
      "enabled": true,
      "email": "eve@example.com",
      "emailVerified": true,
      "firstName": "Eve",
      "lastName": "Example",
      "groups": ["/foobar"],
      "credentials": [
        { "type": "password", "value": "${EVE_PASSWORD}", "temporary": false }
      ]
    }
  ]
}
